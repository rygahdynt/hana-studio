# ==============================================================================
# HANA STUDIO — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env:
#   macOS/Linux:        cp .env.example .env
#   Windows PowerShell: Copy-Item .env.example .env
#
# Keep all real secrets in your local .env file.
# NEVER commit the .env file to Git.
# ==============================================================================

# ==============================================================================
# CURRENT — DATABASE (Required)
# ==============================================================================
# PostgreSQL connection string for Prisma ORM (e.g. Neon PostgreSQL)
DATABASE_URL=""

# ==============================================================================
# CURRENT — APPLICATION (Development Default)
# ==============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==============================================================================
# CURRENT — CLERK AUTHENTICATION (Required)
# ==============================================================================
# Clerk Publishable Key (Client-side)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""

# Clerk Secret Key (Server-side)
CLERK_SECRET_KEY=""

# Clerk Routing URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# ==============================================================================
# CURRENT — OBJECT STORAGE (Required for Asset Uploads & Storage Service)
# ==============================================================================
# S3-compatible object storage (AWS S3, Cloudflare R2, MinIO)
#
# Configuration examples:
#
# Cloudflare R2 (Recommended for Production):
#   S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
#   S3_REGION="auto"
#   S3_BUCKET="your-r2-bucket"
#   S3_ACCESS_KEY_ID="your-r2-key-id"
#   S3_SECRET_ACCESS_KEY="your-r2-secret"
#   S3_PUBLIC_URL="https://pub-xxxx.r2.dev"
#   S3_FORCE_PATH_STYLE="true"
#
# AWS S3:
#   S3_ENDPOINT=""
#   S3_REGION="ap-southeast-1"
#   S3_BUCKET="your-s3-bucket"
#   S3_ACCESS_KEY_ID="your-key-id"
#   S3_SECRET_ACCESS_KEY="your-secret"
#   S3_PUBLIC_URL="https://your-s3-bucket.s3.ap-southeast-1.amazonaws.com"
#   S3_FORCE_PATH_STYLE="false"
#
# MinIO (Local Development):
#   S3_ENDPOINT="http://localhost:9000"
#   S3_REGION="us-east-1"
#   S3_BUCKET="hana-studio"
#   S3_ACCESS_KEY_ID="minioadmin"
#   S3_SECRET_ACCESS_KEY="minioadmin"
#   S3_PUBLIC_URL=""
#   S3_FORCE_PATH_STYLE="true"

S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
S3_FORCE_PATH_STYLE="true"

# ==============================================================================
# CURRENT — MCP (Model Context Protocol)
# ==============================================================================
# Secret key for external MCP clients / connectors (min 16 characters)
MCP_API_KEY=""

# ==============================================================================
# AI CONTENT GENERATION (Optional)
# ==============================================================================
# Provider selection: "openai" | "openrouter" (defaults to "openai")
AI_CONTENT_PROVIDER="openai"

# OpenAI Configuration
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"

# OpenRouter Configuration
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-2.5-flash"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# ==============================================================================
# AI IMAGE GENERATION — GOOGLE VERTEX AI (Required for AI Image Generator)
# ==============================================================================
# Google Cloud Service Account credentials for Vertex AI (gemini-3.1-flash-image)
GOOGLE_SERVICE_ACCOUNT_PROJECT_ID=""
GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
# Optional overrides (defaults to "gemini-3.1-flash-image" and "global")
VERTEX_AI_IMAGE_MODEL="gemini-3.1-flash-image"
VERTEX_AI_LOCATION="global"
